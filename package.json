{
  "name": "capacitor-oidc",
  "version": "0.1.1",
  "description": "OAuth 2.0 and OpenID Connect authentication for Capacitor web, iOS, and Android, powered by oidc-client-ts.",
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "authentication",
    "oauth",
    "oauth2",
    "openid-connect",
    "oidc",
    "pkce",
    "web",
    "ios",
    "android",
    "oidc-client-ts"
  ],
  "main": "dist/plugin.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "contracts/fixtures/stored-session-v1.json",
    "contracts/stored-session-v1.schema.json",
    "dist/",
    "docs/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "CapacitorOidc.podspec",
    "SECURITY.md"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Jojo Pirker"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jojopirker/capacitor-oidc.git"
  },
  "bugs": {
    "url": "https://github.com/jojopirker/capacitor-oidc/issues"
  },
  "homepage": "https://github.com/jojopirker/capacitor-oidc#readme",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "check:package": "node -e \"import('./dist/esm/index.js')\"",
    "clean": "rimraf dist",
    "docs:build": "vitepress build . && cp LICENSE .vitepress/dist/LICENSE",
    "docs:dev": "vitepress dev .",
    "docs:preview": "vitepress preview .",
    "e2e:keycloak:down": "docker compose -f test/e2e/keycloak/compose.yml down",
    "e2e:keycloak:up": "test/e2e/keycloak/create-certificate.sh test/e2e/keycloak/.certificates && docker compose -f test/e2e/keycloak/compose.yml up -d",
    "example:build": "npm --prefix example run build",
    "lint": "eslint src --ext ts && prettier --check src contracts package.json README.md SECURITY.md docs",
    "prepack": "npm run build",
    "test": "vitest run",
    "verify": "npm run lint && npm run test && npm run build && npm run check:package",
    "verify:ios": "xcodebuild -scheme CapacitorOidc -destination generic/platform=iOS CODE_SIGNING_ALLOWED=NO",
    "verify:android": "cd android && ./gradlew clean test assembleDebug"
  },
  "dependencies": {
    "oidc-client-ts": "3.5.0"
  },
  "peerDependencies": {
    "@capacitor/app": ">=7.0.0",
    "@capacitor/core": ">=7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.1",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.1",
    "@capacitor/ios": "7.6.1",
    "@ionic/eslint-config": "0.4.0",
    "@ionic/prettier-config": "4.0.0",
    "@types/node": "24.5.2",
    "eslint": "8.57.1",
    "prettier": "3.6.2",
    "rimraf": "6.1.0",
    "rollup": "4.62.5",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitepress": "2.0.0-alpha.19",
    "vitest": "3.2.7"
  },
  "prettier": "@ionic/prettier-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended",
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_"
        }
      ]
    }
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  }
}
